# Docker Develop .gitignore

# Operating system files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*~

# Editors
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.project
.settings/
.classpath
*.iml

# Local panel environment
.env
!.env.example
/projects.json
!projects.example.json

# Logs and data
/logs/
!/logs/
!/logs/.gitkeep
!/logs/nginx/
!/logs/nginx/.gitkeep
/data/*
!/data/.gitkeep
!/data/demo/
!/data/demo/**
/backups/
/cache/
!/cache/
/cache/*
!/cache/.gitkeep

# Docker Panel Go app
/docker-panel/vendor/
/docker-panel/.gocache/
/docker-panel/runtime/
/docker-panel/runtime/.gitkeep
/docker-panel/.env

# Nginx generated site configs
/services/nginx/sites/*.conf
!/services/nginx/sites/*.conf.example
!/services/nginx/sites/default.conf
/services/nginx/sites/*.bak.*

# SSL certificates
/services/nginx/ssl/*.crt
/services/nginx/ssl/*.key
/services/nginx/ssl/*.pem
!/services/nginx/ssl/.gitkeep

# Temporary files and backups
*.tmp
*.temp
*.bak
*.backup
*.orig
*.log

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn

# Build artifacts
/build/
/dist/
*.min.js
*.min.css

# Coverage
/coverage/

# Tokens
/tmp/docker_panel_tokens.json